{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ixi-O 음성통화 테스트 자동화",
  "version": "0.1.0",
  "identifier": "com.qabulls.call",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "",
        "width": 860,
        "height": 760,
        "minWidth": 760,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "copyright": "\u00a9 2026 QA Bulls",
    "shortDescription": "ixi-O \ud1b5\ud654 \ud14c\uc2a4\ud2b8 \uc790\ub3d9\ud654",
    "resources": ["scripts/*"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
